# Copy to .env.local and fill in. Placeholder values only: never commit real credentials.
# Every variable here is read on the server; none is exposed to the browser.

# Base URL of the Becan backend (the Express API). This app proxies /api/auth/* and /api/v1/*
# to it, so the browser never calls the backend directly. Required in production.
BACKEND_URL=http://localhost:3000

# Object storage that holds each chapter's slides and lesson list. The session page reads them
# through a server-side route so the access key never reaches the browser.
CONTENT_STORAGE_URL=
CONTENT_STORAGE_KEY=
