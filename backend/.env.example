# Copy to .env and fill in. Placeholder values only: never commit real credentials.

NODE_ENV=development
PORT=3000

# The web app's origin. The browser only talks to the web app, which proxies /api/auth/* and
# /api/v1/* to this server.
CORS_ORIGIN=http://localhost:3001
# The admin dashboard's origin (scheme, host and port only). The dashboard is a separate app that is
# not part of this repository; the default is fine when you do not run one. CORS and Better Auth
# accept exactly CORS_ORIGIN and this origin, and both must use the same scheme.
ADMIN_ORIGIN=http://localhost:3002

DATABASE_URL=postgresql://user:password@localhost:5432/becan_dev
# Tests migrate, seed and truncate this database; its name must end in _test.
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/becan_test

# At least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The web app's origin, not this server: the fallback base for links in account emails.
BETTER_AUTH_URL=http://localhost:3001

# LiveKit project that hosts tutor sessions. Required in every environment.
# WebSocket URL returned to clients (ws:// or wss://).
LIVEKIT_URL=wss://your-project.livekit.cloud
# Server-side credentials from the LiveKit project; never expose them to the browser.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Proxy hops in front of Express (sets `trust proxy`).
TRUST_PROXY_HOPS=1
# Comma-separated CIDRs of proxies that append to x-forwarded-for, for Better Auth's client IP.
# Leave empty when only the web app sets x-forwarded-for.
TRUSTED_PROXY_CIDRS=

# Resend, for account emails. Required in production. Without them, development logs each email
# (including its reset or change-email link) instead of sending it.
RESEND_API_KEY=
# For example: Becan <no-reply@example.com>
EMAIL_FROM=
